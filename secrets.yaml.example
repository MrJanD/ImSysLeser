# Kopie als secrets.yaml im ESPHome-Konfigurationsordner anlegen
# (in Home Assistant: /config/esphome/secrets.yaml) und Werte eintragen.
wifi_ssid: "MeinWLAN"
wifi_password: "geheim"
fallback_password: "fallback-hotspot-passwort"
ota_password: "ota-passwort"
# 32 Byte Base64, z. B. erzeugen mit: openssl rand -base64 32
api_key: "BASE64-SCHLUESSEL"
